# https://api.kribblecare.com/v1 in production builds.
# VITE_API_BASE_URL=http://localhost:8000/v1

# Where the dev proxy forwards /api to. Point at a local backend if you have one.
# VITE_API_PROXY_TARGET=http://localhost:8000
